# Backend public API
VITE_API_BASE_URL=

# Public media CDN hostname, for example:
# https://your-store-cdn.b-cdn.net
VITE_MEDIA_CDN_BASE_URL=

# Enable only when Bunny Optimizer is enabled
# on the configured public Pull Zone.
VITE_MEDIA_BUNNY_OPTIMIZER_ENABLED=false

# Browser-delivered image quality.
VITE_MEDIA_IMAGE_QUALITY=82

# IMPORTANT:
# Never place Bunny Storage API keys,
# signing secrets, KYC credentials,
# or any private key in a VITE_* variable.